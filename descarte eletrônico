// server.js
const express = require('express');
const bodyParser = require('body-parser');

const app = express();
const PORT = 3000;

// Middleware
app.use(bodyParser.json());

// "Banco de dados" em memória
let pontosDeColeta = [
    { id: 1, nome: "ReciclaTech Centro", endereco: "Rua A, 123" },
    { id: 2, nome: "EcoEletron", endereco: "Av. B, 456" }
];

// Rota para listar pontos de coleta
app.get('/pontos', (req, res) => {
    res.json(pontosDeColeta);
});

// Rota para adicionar um ponto de coleta
app.post('/pontos', (req, res) => {
    const { nome, endereco } = req.body;

    if (!nome || !endereco) {
        return res.status(400).json({ error: "Nome e endereço são obrigatórios." });
    }

    const novoPonto = {
        id: pontosDeColeta.length + 1,
        nome,
        endereco
    };

    pontosDeColeta.push(novoPonto);
    res.status(201).json(novoPonto);
});

// Iniciar servidor
app.listen(PORT, () => {
    console.log(`Servidor rodando em http://localhost:${PORT}`);
});
