<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EcoDescarte</title>
<style>
body {
    font-family: Arial, sans-serif;
    background: #f0f2f5;
    margin: 0;
    padding: 20px;
}
.container {
    max-width: 600px;
    margin: auto;
    background: #fff;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 0 15px rgba(0,0,0,0.2);
}
h1 {
    text-align: center;
    color: #2e7d32;
}
input, button {
    padding: 10px;
    margin: 5px 0;
    font-size: 16px;
}
input {
    width: calc(50% - 12px);
}
button {
    width: 100%;
    background: #2e7d32;
    color: white;
    border: none;
    cursor: pointer;
    border-radius: 5px;
}
button:hover {
    background: #1b5e20;
}
ul {
    list-style: none;
    padding: 0;
}
li {
    background: #e8ffe8;
    margin: 5px 0;
    padding: 10px;
    border-radius: 5px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
button.delete {
    background: #c62828;
    padding: 5px 10px;
    border: none;
    color: white;
    border-radius: 5px;
    cursor: pointer;
}
button.delete:hover {
    background: #b71c1c;
}
</style>
</head>
<body>

<div class="container">
    <h1>EcoDescarte</h1>

    <input type="text" id="equipamento" placeholder="Nome do equipamento">
    <input type="text" id="local" placeholder="Local de descarte">
    <button onclick="adicionar()">Adicionar</button>

    <h2>Registros</h2>
    <ul id="lista"></ul>
</div>

<script>
let registros = JSON.parse(localStorage.getItem("registros")) || [];

function salvar() {
    localStorage.setItem("registros", JSON.stringify(registros));
}

function atualizarLista() {
    const lista = document.getElementById("lista");
    lista.innerHTML = "";
    registros.forEach((r, index) => {
        const li = document.createElement("li");
        li.innerHTML = `<span><strong>${r.equipamento}</strong> - ${r.local}</span>
                        <button class="delete" onclick="deletar(${index})">Excluir</button>`;
        lista.appendChild(li);
    });
}

function adicionar() {
    const equipamento = document.getElementById("equipamento").value.trim();
    const local = document.getElementById("local").value.trim();
    if (!equipamento || !local) {
        alert("Preencha todos os campos!");
        return;
    }
    registros.push({ equipamento, local });
    salvar();
    atualizarLista();
    document.getElementById("equipamento").value = "";
    document.getElementById("local").value = "";
}

function deletar(index) {
    registros.splice(index, 1);
    salvar();
    atualizarLista();
}

// Carrega a lista ao abrir
atualizarLista();
</script>

</body>
</html>
