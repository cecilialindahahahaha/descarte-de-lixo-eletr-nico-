const express = require('express');
const fs = require('fs');
const bodyParser = require('body-parser');

const app = express();
const PORT = 3000;
const DATA_FILE = 'pontos.json';

app.use(bodyParser.json());

// Função para ler os pontos de coleta
function lerPontos() {
    try {
        const data = fs.readFileSync(DATA_FILE, 'utf-8');
        return JSON.parse(data);
    } catch (err) {
        console.error("Erro ao ler pontos.json:", err);
        return [];
    }
}

// Função para salvar os pontos de coleta
function salvarPontos(pontos) {
    fs.writeFileSync(DATA_FILE, JSON.stringify(pontos, null, 2));
}

// Rota para listar pontos de coleta
app.get('/pontos', (req, res) => {
    const pontos = lerPontos();
    res.json(pontos);
});

// Rota para adicionar um ponto de coleta
app.post('/pontos', (req, res) => {
    const { nome, endereco } = req.body;

    if (!nome || !endereco) {
        return res.status(400).json({ error: "Nome e endereço são obrigatórios." });
    }

    const pontos = lerPontos();
    const novoPonto = {
        id: pontos.length + 1,
        nome,
        endereco
    };

    pontos.push(novoPonto);
    salvarPontos(pontos);

    res.status(201).json(novoPonto);
});

// Rota para buscar ponto por ID
app.get('/pontos/:id', (req, res) => {
    const pontos = lerPontos();
    const ponto = pontos.find(p => p.id === parseInt(req.params.id));

    if (!ponto) {
        return res.status(404).json({ error: "Ponto não encontrado." });
    }

    res.json(ponto);
});

// Iniciar servidor
app.listen(PORT, () => {
    console.log(`Servidor rodando em http://localhost:${PORT}`);
});
