<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Descarte Eletrônico</title>

<style>
body{
    font-family: Arial, sans-serif;
    background:#f4f4f4;
    margin:0;
    padding:20px;
}

.container{
    max-width:700px;
    margin:auto;
    background:white;
    padding:20px;
    border-radius:10px;
    box-shadow:0 0 10px rgba(0,0,0,0.2);
}

h1{
    color:green;
    text-align:center;
}

input{
    width:100%;
    padding:10px;
    margin:5px 0;
    box-sizing:border-box;
}

button{
    width:100%;
    padding:10px;
    background:green;
    color:white;
    border:none;
    cursor:pointer;
}

button:hover{
    background:darkgreen;
}

.item{
    background:#e8ffe8;
    padding:10px;
    margin-top:10px;
    border-radius:5px;
}
</style>

</head>
<body>

<div class="container">
    <h1>Cadastro de Descarte Eletrônico</h1>

    <input type="text" id="equipamento" placeholder="Nome do equipamento">
    <input type="text" id="local" placeholder="Local de descarte">

    <button onclick="adicionar()">Cadastrar</button>

    <h2>Registros</h2>

    <div id="lista"></div>
</div>

<script>

function adicionar(){

    let equipamento = document.getElementById("equipamento").value;
    let local = document.getElementById("local").value;

    if(equipamento === "" || local === ""){
        alert("Preencha todos os campos!");
        return;
    }

    let div = document.createElement("div");
    div.className = "item";

    div.innerHTML =
        "<strong>Equipamento:</strong> " + equipamento +
        "<br><strong>Local:</strong> " + local;

    document.getElementById("lista").appendChild(div);

    document.getElementById("equipamento").value = "";
    document.getElementById("local").value = "";
}

</script>

</body>
</html>
